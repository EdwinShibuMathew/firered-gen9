+// Insert at most one line break, keeping each condition inside the 216-pixel
+// content region. The 128-byte buffer and bounded Append calls remain the hard
+// safety boundary even for unusually long item or move names.
+static void WrapCondition(void)
+{
+    u32 i, lastSpace = 0;
+    for (i = 0; sText[i] != EOS; ++i)
+    {
+        u8 saved;
+        if (sText[i] == CHAR_SPACE)
+            lastSpace = i;
+        saved = sText[i + 1];
+        sText[i + 1] = EOS;
+        if (lastSpace && GetStringWidth(0, sText, 0) > 216)
+        {
+            sText[i + 1] = saved;
+            sText[lastSpace] = CHAR_NEWLINE;
+            return;
+        }
+        sText[i + 1] = saved;
+    }
+}
