diff --git a/src/scripting.c b/src/scripting.c
index 3df76d2..941e783 100644
--- a/src/scripting.c
+++ b/src/scripting.c
@@ -90,6 +90,28 @@ struct M5FormLabFamily
 #include "../include/generated/m5_form_routes.h"
 
 static const u8 *sM5FormLabDynamicNames[M5_FORM_LAB_MAX_OPTIONS];
+static const u8 *sM5ResearchPreserveNames[M5_RESEARCH_PRESERVE_COUNT];
+
+void M5ResearchPreservePrepareMenu(void)
+{
+    u32 i;
+    for (i = 0; i < M5_RESEARCH_PRESERVE_COUNT; ++i)
+        sM5ResearchPreserveNames[i] = gSpeciesNames[sM5ResearchPreserveForms[i]];
+    Var8000 = 2;
+    Var8001 = 6;
+    gSpecialVar_LastResult = TRUE;
+}
+
+void M5ResearchPreservePrepareEncounter(void)
+{
+    u16 selected = gSpecialVar_LastResult;
+    gSpecialVar_LastResult = FALSE;
+    if (selected >= M5_RESEARCH_PRESERVE_COUNT)
+        return;
+    Var8000 = sM5ResearchPreserveForms[selected];
+    GetSpeciesName(gStringVar1, Var8000);
+    gSpecialVar_LastResult = TRUE;
+}
 
 // Called after ChoosePartyMon. Selects the matching generated scrolling-list
 // binding; no Pokemon data is touched until the separate apply call.
@@ -3084,6 +3106,7 @@ const struct ScrollingMulti gScrollingSets[] =
 {
 	{sMultichoiceSet1, ARRAY_COUNT(sMultichoiceSet1)},
 	{sM5FormLabDynamicNames, M5_FORM_LAB_MAX_OPTIONS},
+	{sM5ResearchPreserveNames, M5_RESEARCH_PRESERVE_COUNT},
 };
 
 //Link number of opts shown at once to the box height
@@ -3118,6 +3141,8 @@ u32 GetSizeOfMultiList(void)
 #ifdef SCROLLING_MULTICHOICE
 	if (Var8000 == 1 && Var8006 < ARRAY_COUNT(sM5FormLabFamilies))
 		return sM5FormLabFamilies[Var8006].count;
+	if (Var8000 == 2)
+		return M5_RESEARCH_PRESERVE_COUNT;
 	return gScrollingSets[Var8000].count;
 #else
 	return 0;
diff --git a/assembly/overworld_scripts/system_scripts.s b/assembly/overworld_scripts/system_scripts.s
index 7b3638d..b8b4f66 100644
--- a/assembly/overworld_scripts/system_scripts.s
+++ b/assembly/overworld_scripts/system_scripts.s
@@ -15,6 +15,15 @@
 EventScript_M5FormResearcher:
 	lockall
 	faceplayer
+	msgbox gText_M5ResearchServices MSG_KEEPOPEN
+	multichoiceoption gText_M5ResearchFormLab 0
+	multichoiceoption gText_M5ResearchPreserve 1
+	multichoiceoption gText_M5ResearchCancel 2
+	multichoice 0, 0, THREE_MULTICHOICE_OPTIONS, 0
+	compare LASTRESULT 1
+	if equal _goto EventScript_M5ResearchPreserve
+	compare LASTRESULT 0
+	if notequal _goto EventScript_M5FormResearcherCancel
 	msgbox gText_M5FormLabIntro MSG_NORMAL
 	special SPECIAL_CHOOSE_PARTY_MON
 	waitstate
@@ -64,6 +73,35 @@ EventScript_M5FormResearcherCancel:
 	releaseall
 	end
 
+.global EventScript_M5ResearchPreserve
+EventScript_M5ResearchPreserve:
+	checkflag FLAG_M5_GAME_CLEAR
+	compare LASTRESULT FALSE
+	if equal _goto EventScript_M5ResearchPreserveLocked
+	msgbox gText_M5ResearchPreserveIntro MSG_NORMAL
+	callasm M5ResearchPreservePrepareMenu
+	resetvar 0x8004
+	resetvar 0x800D
+	special 0x158
+	waitstate
+	compare LASTRESULT 0x7F
+	if equal _goto EventScript_M5FormResearcherCancel
+	callasm M5ResearchPreservePrepareEncounter
+	compare LASTRESULT FALSE
+	if equal _goto EventScript_M5FormResearcherFailed
+	msgbox gText_M5ResearchPreserveConfirm MSG_YESNO
+	compare LASTRESULT NO
+	if equal _goto EventScript_M5FormResearcherCancel
+	setwildbattle 0x8000 30 0
+	dowildbattle
+	releaseall
+	end
+
+EventScript_M5ResearchPreserveLocked:
+	msgbox gText_M5ResearchPreserveLocked MSG_NORMAL
+	releaseall
+	end
+
 @;@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 
