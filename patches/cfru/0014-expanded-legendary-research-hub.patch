+.macro m5_hub_encounter name, flag, species
+EventScript_M5Legendary\name:
+	checkflag \flag
+	compare LASTRESULT TRUE
+	if equal _goto EventScript_M5LegendaryCompleted
+	msgbox gText_M5LegendaryAvailable MSG_YESNO
+	compare LASTRESULT NO
+	if equal _goto EventScript_M5LegendaryCoordinator
+	setvar 0x8000 \species
+	setvar 0x8001 \flag
+	goto EventScript_M5LegendaryDirectBattle
+.endm
+
+	m5_hub_encounter Celebi, FLAG_M5_FOUGHT_CELEBI, SPECIES_CELEBI
+	m5_hub_encounter Regirock, FLAG_M5_FOUGHT_REGIROCK, SPECIES_REGIROCK
+	m5_hub_encounter Regice, FLAG_M5_FOUGHT_REGICE, SPECIES_REGICE
+	m5_hub_encounter Registeel, FLAG_M5_FOUGHT_REGISTEEL, SPECIES_REGISTEEL
+	m5_hub_encounter Rayquaza, FLAG_M5_FOUGHT_RAYQUAZA, SPECIES_RAYQUAZA
+	m5_hub_encounter Darkrai, FLAG_M5_FOUGHT_DARKRAI, SPECIES_DARKRAI
+	m5_hub_encounter Arceus, FLAG_M5_FOUGHT_ARCEUS, SPECIES_ARCEUS
+	m5_hub_encounter Victini, FLAG_M5_FOUGHT_VICTINI, SPECIES_VICTINI
+	m5_hub_encounter Keldeo, FLAG_M5_FOUGHT_KELDEO, SPECIES_KELDEO
+	m5_hub_encounter Eternatus, FLAG_M5_FOUGHT_ETERNATUS, SPECIES_ETERNATUS
+	m5_hub_encounter Enamorus, FLAG_M5_FOUGHT_ENAMORUS, SPECIES_ENAMORUS
+	m5_hub_encounter Pecharunt, FLAG_M5_FOUGHT_PECHARUNT, SPECIES_PECHARUNT
+	m5_hub_encounter Meloetta, FLAG_M5_FOUGHT_MELOETTA, SPECIES_MELOETTA
+	m5_hub_encounter Diancie, FLAG_M5_FOUGHT_DIANCIE, SPECIES_DIANCIE
+	m5_hub_encounter Volcanion, FLAG_M5_FOUGHT_VOLCANION, SPECIES_VOLCANION
+	m5_hub_encounter Magearna, FLAG_M5_FOUGHT_MAGEARNA, SPECIES_MAGEARNA
+	m5_hub_encounter Marshadow, FLAG_M5_FOUGHT_MARSHADOW, SPECIES_MARSHADOW
+	m5_hub_encounter Zeraora, FLAG_M5_FOUGHT_ZERAORA, SPECIES_ZERAORA
+	m5_hub_encounter Celesteela, FLAG_M5_FOUGHT_CELESTEELA, SPECIES_CELESTEELA
+
+EventScript_M5LegendaryDirectBattle:
+	bufferpokemon 0x0 0x8000
+	msgbox gText_M5LegendaryDirectBattle MSG_NORMAL
+	setwildbattle 0x8000 70 0
+	dowildbattle
+	special2 LASTRESULT 0xB4
+	compare LASTRESULT 0x7
+	if notequal _goto EventScript_M5LegendaryRecovered
+	switch 0x8000
+	case SPECIES_CELEBI, EventScript_M5LegendaryCaughtCelebi
+	case SPECIES_REGIROCK, EventScript_M5LegendaryCaughtRegirock
+	case SPECIES_REGICE, EventScript_M5LegendaryCaughtRegice
+	case SPECIES_REGISTEEL, EventScript_M5LegendaryCaughtRegisteel
+	case SPECIES_RAYQUAZA, EventScript_M5LegendaryCaughtRayquaza
+	case SPECIES_DARKRAI, EventScript_M5LegendaryCaughtDarkrai
+	case SPECIES_ARCEUS, EventScript_M5LegendaryCaughtArceus
+	case SPECIES_VICTINI, EventScript_M5LegendaryCaughtVictini
+	case SPECIES_KELDEO, EventScript_M5LegendaryCaughtKeldeo
+	case SPECIES_ETERNATUS, EventScript_M5LegendaryCaughtEternatus
+	case SPECIES_ENAMORUS, EventScript_M5LegendaryCaughtEnamorus
+	case SPECIES_PECHARUNT, EventScript_M5LegendaryCaughtPecharunt
+	case SPECIES_MELOETTA, EventScript_M5LegendaryCaughtMeloetta
+	case SPECIES_DIANCIE, EventScript_M5LegendaryCaughtDiancie
+	case SPECIES_VOLCANION, EventScript_M5LegendaryCaughtVolcanion
+	case SPECIES_MAGEARNA, EventScript_M5LegendaryCaughtMagearna
+	case SPECIES_MARSHADOW, EventScript_M5LegendaryCaughtMarshadow
+	case SPECIES_ZERAORA, EventScript_M5LegendaryCaughtZeraora
+	case SPECIES_CELESTEELA, EventScript_M5LegendaryCaughtCelesteela
+	goto EventScript_M5LegendaryRecovered
+
