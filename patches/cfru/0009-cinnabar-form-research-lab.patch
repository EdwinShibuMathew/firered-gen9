+static const u16 sM5FormLabRotom[] = {
+    SPECIES_ROTOM, SPECIES_ROTOM_HEAT, SPECIES_ROTOM_WASH,
+    SPECIES_ROTOM_FROST, SPECIES_ROTOM_FAN, SPECIES_ROTOM_MOW,
+};
+static const u16 sM5FormLabDeoxys[] = {
+    SPECIES_DEOXYS, SPECIES_DEOXYS_ATTACK,
+    SPECIES_DEOXYS_DEFENSE, SPECIES_DEOXYS_SPEED,
+};
+static const u16 sM5FormLabShaymin[] = {SPECIES_SHAYMIN, SPECIES_SHAYMIN_SKY};
+static const u16 sM5FormLabHoopa[] = {SPECIES_HOOPA, SPECIES_HOOPA_UNBOUND};
+static const u16 sM5FormLabFurfrou[] = {
+    SPECIES_FURFROU, SPECIES_FURFROU_HEART, SPECIES_FURFROU_DIAMOND,
+    SPECIES_FURFROU_STAR, SPECIES_FURFROU_PHAROAH, SPECIES_FURFROU_KABUKI,
+    SPECIES_FURFROU_LA_REINE, SPECIES_FURFROU_MATRON,
+    SPECIES_FURFROU_DANDY, SPECIES_FURFROU_DEBUTANTE,
+};
+
+struct M5FormLabFamily
+{
+    const u16 *forms;
+    u8 count;
+};
+
+static const struct M5FormLabFamily sM5FormLabFamilies[] = {
+    {sM5FormLabRotom, ARRAY_COUNT(sM5FormLabRotom)},
+    {sM5FormLabDeoxys, ARRAY_COUNT(sM5FormLabDeoxys)},
+    {sM5FormLabShaymin, ARRAY_COUNT(sM5FormLabShaymin)},
+    {sM5FormLabHoopa, ARRAY_COUNT(sM5FormLabHoopa)},
+    {sM5FormLabFurfrou, ARRAY_COUNT(sM5FormLabFurfrou)},
+};
+
+// Called by the Cinnabar Form Researcher after ChoosePartyMon.  It chooses
+// the next safe, reversible form in the selected mon's family and exposes it
+// through Var8005 for confirmation by the injected event script.
+void M5FormLabPrepareNextForm(void)
+{
+    u16 current;
+    u32 family, form;
+
+    gSpecialVar_LastResult = FALSE;
+    if (Var8004 >= PARTY_SIZE || GetMonData(&gPlayerParty[Var8004], MON_DATA_IS_EGG, NULL))
+        return;
+    current = GetMonData(&gPlayerParty[Var8004], MON_DATA_SPECIES2, NULL);
+    if (current == SPECIES_NONE)
+        return;
+
+    for (family = 0; family < ARRAY_COUNT(sM5FormLabFamilies); ++family)
+    {
+        for (form = 0; form < sM5FormLabFamilies[family].count; ++form)
+        {
+            if (sM5FormLabFamilies[family].forms[form] == current)
+            {
+                Var8005 = sM5FormLabFamilies[family].forms[(form + 1) % sM5FormLabFamilies[family].count];
+                GetSpeciesName(gStringVar1, Var8005);
+                gSpecialVar_LastResult = TRUE;
+                return;
+            }
+        }
+    }
+}
+
+void M5FormLabApplyPreparedForm(void)
+{
+    gSpecialVar_LastResult = FALSE;
+    if (Var8004 >= PARTY_SIZE)
+        return;
+    if (TryChangeMonForm(&gPlayerParty[Var8004], Var8005))
+    {
+        SetMonPokedexFlags(&gPlayerParty[Var8004]);
+        gSpecialVar_LastResult = TRUE;
+    }
+}
+
 #define POKERUS_CURED 0x10
 
