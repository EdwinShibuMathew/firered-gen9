diff --git a/assembly/overworld_scripts/system_scripts.s b/assembly/overworld_scripts/system_scripts.s
index bb52884d..5180e96d 100644
--- a/assembly/overworld_scripts/system_scripts.s
+++ b/assembly/overworld_scripts/system_scripts.s
@@ -7,6 +7,46 @@
 .include "../asm_defines.s"
 
 .equ SPECIAL_STOP_SOUNDS, 0x9A
+.equ SPECIAL_CHOOSE_PARTY_MON, 0x9F
+
+@;@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
+
+.global EventScript_M5FormResearcher
+EventScript_M5FormResearcher:
+	lockall
+	faceplayer
+	msgbox gText_M5FormLabIntro MSG_NORMAL
+	special SPECIAL_CHOOSE_PARTY_MON
+	waitstate
+	compare 0x8004 PARTY_SIZE
+	if greaterorequal _goto EventScript_M5FormResearcherCancel
+	callasm M5FormLabPrepareNextForm
+	compare LASTRESULT FALSE
+	if equal _goto EventScript_M5FormResearcherUnsupported
+	msgbox gText_M5FormLabConfirm MSG_YESNO
+	compare LASTRESULT NO
+	if equal _goto EventScript_M5FormResearcherCancel
+	callasm M5FormLabApplyPreparedForm
+	compare LASTRESULT FALSE
+	if equal _goto EventScript_M5FormResearcherFailed
+	msgbox gText_M5FormLabSuccess MSG_NORMAL
+	releaseall
+	end
+
+EventScript_M5FormResearcherUnsupported:
+	msgbox gText_M5FormLabUnsupported MSG_NORMAL
+	releaseall
+	end
+
+EventScript_M5FormResearcherFailed:
+	msgbox gText_M5FormLabFailed MSG_NORMAL
+	releaseall
+	end
+
+EventScript_M5FormResearcherCancel:
+	msgbox gText_M5FormLabCancel MSG_NORMAL
+	releaseall
+	end
 
 @;@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 
