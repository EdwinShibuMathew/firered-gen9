+static void Task_DexNavMigrationSelect(u8 taskId)
+{
+	u16 group = gTasks[taskId].data[14];
+	if (JOY_REPT(DPAD_UP))
+	{
+		group = group <= 1 ? M7_MIGRATION_GROUP_COUNT : group - 1;
+		gTasks[taskId].data[14] = group;
+		PlaySE(SE_POKENAV_ONE_BEEP);
+		M7PrintMigrationChoice(group);
+	}
+	else if (JOY_REPT(DPAD_DOWN))
+	{
+		group = group >= M7_MIGRATION_GROUP_COUNT ? 1 : group + 1;
+		gTasks[taskId].data[14] = group;
+		PlaySE(SE_POKENAV_ONE_BEEP);
+		M7PrintMigrationChoice(group);
+	}
+	else if (JOY_NEW(A_BUTTON))
+	{
+		VarSet(VAR_M7_MIGRATION_GROUP, group);
+		PlaySE(SE_SELECT);
+		BeginNormalPaletteFade(0xFFFFFFFF, 0, 0, 16, RGB_BLACK);
+		gTasks[taskId].func = Task_DexNavFadeOutToMigrationRefresh;
+	}
+	else if (JOY_NEW(B_BUTTON) || JOY_NEW(SELECT_BUTTON))
+	{
+		PlaySE(SE_SELECT);
+		HideDexNavMessage();
+		gTasks[taskId].func = Task_DexNavWaitForKeyPress;
+	}
+}
