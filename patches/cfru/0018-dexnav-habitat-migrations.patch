+static u16 M7GetMigrationSpecies(void)
+{
+	u16 group = VarGet(VAR_M7_MIGRATION_GROUP);
+	if (group < 1 || group > M7_MIGRATION_GROUP_COUNT)
+		return SPECIES_NONE;
+	return sM7MigrationGroups[group - 1][GetCurrentRegionMapSectionId() % M7_MIGRATION_GROUP_SIZE];
+}
+
+static bool8 M7IsMigrationSpecies(u16 species)
+{
+	return species != SPECIES_NONE && species == M7GetMigrationSpecies();
+}
+
+static void M7PrintMigrationChoice(u16 group)
+{
+	if (group < 1 || group > M7_MIGRATION_GROUP_COUNT)
+		group = 1;
+	StringCopy(gStringVar1, sM7MigrationNames[group - 1]);
+	PrintDexNavMessage(MESSAGE_MIGRATION_SELECT);
+}
