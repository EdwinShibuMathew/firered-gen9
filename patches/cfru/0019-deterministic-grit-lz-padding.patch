+def NormalizeGritLzPadding(assemblyFile: str):
+    """Zero grit's uninitialized 4-byte tail padding after LZ77 streams."""
+    text = Path(assemblyFile).read_text(encoding='utf-8')
+    sectionPattern = re.compile(r'(?ms)(^\s*\.section[^\n]*\n.*?)(?=^\s*\.section|\Z)')
+    directivePattern = re.compile(r'(?m)^\s*\.(byte|hword)\s+([^\n]+)')
+    numberPattern = re.compile(r'0x[0-9A-Fa-f]+|\d+')
+
+    def normalizeSection(match):
+        section = match.group(0)
+        values = bytearray()
+        tokens = []
+        for directive in directivePattern.finditer(section):
+            width = 1 if directive.group(1) == 'byte' else 2
+            for number in numberPattern.finditer(directive.group(2)):
+                value = int(number.group(0), 0)
+                offset = len(values)
+                values.extend(value.to_bytes(width, 'little'))
+                start = directive.start(2) + number.start()
+                end = directive.start(2) + number.end()
+                tokens.append((start, end, offset, width))
+
+        if len(values) < 5 or values[0] != 0x10:
+            return section
+        outputSize = int.from_bytes(values[1:4], 'little')
+        source = 4
+        produced = 0
+        while produced < outputSize and source < len(values):
+            flags = values[source]
+            source += 1
+            for bit in range(8):
+                if produced >= outputSize:
+                    break
+                if flags & (0x80 >> bit):
+                    if source + 2 > len(values):
+                        return section
+                    produced += (values[source] >> 4) + 3
+                    source += 2
+                else:
+                    if source >= len(values):
+                        return section
+                    produced += 1
+                    source += 1
+
+        padding = len(values) - source
+        if produced < outputSize or padding <= 0 or padding > 3:
+            return section
+        values[source:] = b'\0' * padding
+        replacements = []
+        for start, end, offset, width in tokens:
+            if offset + width > source:
+                value = int.from_bytes(values[offset:offset + width], 'little')
+                replacements.append((start, end, '0x{:0{}X}'.format(value, width * 2)))
+        for start, end, value in reversed(replacements):
+            section = section[:start] + value + section[end:]
+        return section
+
+    normalized = sectionPattern.sub(normalizeSection, text)
+    Path(assemblyFile).write_text(normalized, encoding='utf-8')
+
