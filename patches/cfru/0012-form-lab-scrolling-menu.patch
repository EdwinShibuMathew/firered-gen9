diff --git a/assembly/overworld_scripts/system_scripts.s b/assembly/overworld_scripts/system_scripts.s
index 5c28a19..8262c6e 100644
--- a/assembly/overworld_scripts/system_scripts.s
+++ b/assembly/overworld_scripts/system_scripts.s
@@ -23,6 +23,17 @@ EventScript_M5FormResearcher:
 	callasm M5FormLabPrepareNextForm
 	compare LASTRESULT FALSE
 	if equal _goto EventScript_M5FormResearcherUnsupported
+	copyvar 0x8007 0x8004
+	resetvar 0x8004
+	resetvar 0x800D
+	special 0x158
+	waitstate
+	copyvar 0x8004 0x8007
+	compare LASTRESULT 0x7F
+	if equal _goto EventScript_M5FormResearcherCancel
+	callasm M5FormLabPrepareSelectedForm
+	compare LASTRESULT FALSE
+	if equal _goto EventScript_M5FormResearcherNoChange
 	msgbox gText_M5FormLabConfirm MSG_YESNO
 	compare LASTRESULT NO
 	if equal _goto EventScript_M5FormResearcherCancel
@@ -43,6 +54,11 @@ EventScript_M5FormResearcherFailed:
 	releaseall
 	end
 
+EventScript_M5FormResearcherNoChange:
+	msgbox gText_M5FormLabNoChange MSG_NORMAL
+	releaseall
+	end
+
 EventScript_M5FormResearcherCancel:
 	msgbox gText_M5FormLabCancel MSG_NORMAL
 	releaseall
