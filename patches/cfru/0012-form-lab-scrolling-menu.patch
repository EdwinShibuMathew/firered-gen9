diff --git a/src/scripting.c b/src/scripting.c
index 6b9292d..1a0b16b 100644
--- a/src/scripting.c
+++ b/src/scripting.c
@@ -112,9 +112,8 @@ static const struct M5FormLabFamily sM5FormLabFamilies[] = {
     {sM5FormLabFurfrou, ARRAY_COUNT(sM5FormLabFurfrou)},
 };
 
-// Called by the Cinnabar Form Researcher after ChoosePartyMon.  It chooses
-// the next safe, reversible form in the selected mon's family and exposes it
-// through Var8005 for confirmation by the injected event script.
+// Called after ChoosePartyMon. Selects the matching generated scrolling-list
+// binding; no Pokemon data is touched until the separate apply call.
 void M5FormLabPrepareNextForm(void)
 {
     u16 current;
@@ -133,8 +132,9 @@ void M5FormLabPrepareNextForm(void)
         {
             if (sM5FormLabFamilies[family].forms[form] == current)
             {
-                Var8005 = sM5FormLabFamilies[family].forms[(form + 1) % sM5FormLabFamilies[family].count];
-                GetSpeciesName(gStringVar1, Var8005);
+                Var8000 = family + 1; // gScrollingSets[0] is the Tera-type list.
+                Var8001 = 6;
+                Var8006 = family;
                 gSpecialVar_LastResult = TRUE;
                 return;
             }
@@ -142,6 +142,23 @@ void M5FormLabPrepareNextForm(void)
     }
 }
 
+void M5FormLabPrepareSelectedForm(void)
+{
+    u16 current;
+    u16 selected = gSpecialVar_LastResult;
+    u16 family = Var8006;
+    gSpecialVar_LastResult = FALSE;
+    if (Var8004 >= PARTY_SIZE || family >= ARRAY_COUNT(sM5FormLabFamilies)
+     || selected >= sM5FormLabFamilies[family].count)
+        return;
+    current = GetMonData(&gPlayerParty[Var8004], MON_DATA_SPECIES2, NULL);
+    Var8005 = sM5FormLabFamilies[family].forms[selected];
+    if (current == Var8005)
+        return;
+    GetSpeciesName(gStringVar1, Var8005);
+    gSpecialVar_LastResult = TRUE;
+}
+
 void M5FormLabApplyPreparedForm(void)
 {
     gSpecialVar_LastResult = FALSE;
@@ -3046,6 +3063,13 @@ extern const u8 sText_Dragon[];
 extern const u8 sText_Dark[];
 extern const u8 sText_Fairy[];
 extern const u8 sText_Stellar[];
+extern const u8 gText_M5FormRotom[], gText_M5FormRotomHeat[], gText_M5FormRotomWash[];
+extern const u8 gText_M5FormRotomFrost[], gText_M5FormRotomFan[], gText_M5FormRotomMow[];
+extern const u8 gText_M5FormDeoxys[], gText_M5FormDeoxysAttack[], gText_M5FormDeoxysDefense[], gText_M5FormDeoxysSpeed[];
+extern const u8 gText_M5FormShaymin[], gText_M5FormShayminSky[], gText_M5FormHoopa[], gText_M5FormHoopaUnbound[];
+extern const u8 gText_M5FormFurfrou[], gText_M5FormFurfrouHeart[], gText_M5FormFurfrouDiamond[], gText_M5FormFurfrouStar[];
+extern const u8 gText_M5FormFurfrouPharaoh[], gText_M5FormFurfrouKabuki[], gText_M5FormFurfrouLaReine[];
+extern const u8 gText_M5FormFurfrouMatron[], gText_M5FormFurfrouDandy[], gText_M5FormFurfrouDebutante[];
 
 // Scrolling Lists
 static const u8* sMultichoiceSet1[] =
@@ -3071,10 +3095,21 @@ static const u8* sMultichoiceSet1[] =
 	sText_Stellar,
 };
 
+static const u8 *const sM5FormLabRotomNames[] = {gText_M5FormRotom, gText_M5FormRotomHeat, gText_M5FormRotomWash, gText_M5FormRotomFrost, gText_M5FormRotomFan, gText_M5FormRotomMow};
+static const u8 *const sM5FormLabDeoxysNames[] = {gText_M5FormDeoxys, gText_M5FormDeoxysAttack, gText_M5FormDeoxysDefense, gText_M5FormDeoxysSpeed};
+static const u8 *const sM5FormLabShayminNames[] = {gText_M5FormShaymin, gText_M5FormShayminSky};
+static const u8 *const sM5FormLabHoopaNames[] = {gText_M5FormHoopa, gText_M5FormHoopaUnbound};
+static const u8 *const sM5FormLabFurfrouNames[] = {gText_M5FormFurfrou, gText_M5FormFurfrouHeart, gText_M5FormFurfrouDiamond, gText_M5FormFurfrouStar, gText_M5FormFurfrouPharaoh, gText_M5FormFurfrouKabuki, gText_M5FormFurfrouLaReine, gText_M5FormFurfrouMatron, gText_M5FormFurfrouDandy, gText_M5FormFurfrouDebutante};
+
 // Multichoice Lists
 const struct ScrollingMulti gScrollingSets[] =
 {
 	{sMultichoiceSet1, ARRAY_COUNT(sMultichoiceSet1)},
+	{sM5FormLabRotomNames, ARRAY_COUNT(sM5FormLabRotomNames)},
+	{sM5FormLabDeoxysNames, ARRAY_COUNT(sM5FormLabDeoxysNames)},
+	{sM5FormLabShayminNames, ARRAY_COUNT(sM5FormLabShayminNames)},
+	{sM5FormLabHoopaNames, ARRAY_COUNT(sM5FormLabHoopaNames)},
+	{sM5FormLabFurfrouNames, ARRAY_COUNT(sM5FormLabFurfrouNames)},
 };
 
