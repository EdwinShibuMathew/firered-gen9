-void DoItemFormChange(struct Pokemon* mon, u16 species)
+
+// Single validation/mutation boundary for permanent party form changes.
+bool8 TryChangeMonForm(struct Pokemon *mon, u16 targetSpecies)
 {
-        SetMonData(mon, MON_DATA_SPECIES, &species);
+        u16 currentSpecies;
+        u16 oldHp, newMaxHp;
+
+        if (mon == NULL || targetSpecies == SPECIES_NONE || targetSpecies >= NUM_SPECIES)
+                return FALSE;
+        if (GetMonData(mon, MON_DATA_IS_EGG, NULL))
+                return FALSE;
+        currentSpecies = GetMonData(mon, MON_DATA_SPECIES2, NULL);
+        if (currentSpecies == SPECIES_NONE || currentSpecies == targetSpecies)
+                return FALSE;
+        if (SpeciesToNationalPokedexNum(targetSpecies) == NATIONAL_DEX_NONE)
+                return FALSE;
+
+        oldHp = GetMonData(mon, MON_DATA_HP, NULL);
+        SetMonData(mon, MON_DATA_SPECIES, &targetSpecies);
         CalculateMonStats(mon);
+        newMaxHp = GetMonData(mon, MON_DATA_MAX_HP, NULL);
+        if (oldHp > newMaxHp)
+                oldHp = newMaxHp;
+        SetMonData(mon, MON_DATA_HP, &oldHp);
+        return TRUE;
+}
+
+void DoItemFormChange(struct Pokemon* mon, u16 species)
+{
+        if (!TryChangeMonForm(mon, species))
+                return;
         UpdateMonIconSpecies(sPartyMenuBoxes[gPartyMenu.slotId].monSpriteId, species);
         PlayCry1(species, 0);
